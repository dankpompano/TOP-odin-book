<h1>Posts#new</h1>
<p>Find me in app/views/posts/new.html.erb</p>

<h1>Create a new post</h1>
<%= form_with model: @post do |f| %>
  <div>
    <h3>Post to: <%=current_user.username%>'s profile</h3>
    <%= f.label :subject %>
    <%= f.text_field :subject %><br>

    <%= f.label :body %>
    <%= f.text_field :body %><br>

    <%= f.submit "Post" %> 
  </div>
<% end %>
