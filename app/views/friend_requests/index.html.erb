<h1>FriendRequests#index</h1>
<p>Find me in app/views/friend_requests/index.html.erb</p>

<table>

  <thead>
    <div>
      <th>Send a request</th>
        <%= form_with url: friend_requests_index_path, method: :get do |form| %>
          <%= form.label :username, "Connect with Users: " %>
          <%= form.text_field :username, value: params[:users], placeholder: "Enter username..." %>    
          <%= form.submit "Send Request" %>
        <% end %>
    </div>
  </thead>
  <thead>
    <div>
      <th>Incoming Requests</th>
      <% @friend_requests.each do |request| %>
        <tbody>
          <th>From:</th>
          <th>Status:</th>

          <tr>
            <td><%=request.sender.username%></td>
            <td><%=request.status%></td>
            <%=button_to "Accept", accept_friend_request_path(request), action: "accept"%>
            <%=button_to "Decline", decline_friend_request_path(request), action: "decline"%>
          </tr>
        </tbody>
      <% end %>
    </div>
  </thead>
</table>

<table>
  <thead>
      <th>Outgoing Requests</th>
      <% @friend_requests.each do |request| %>
        <thead>
          <th><%=request.status%></th>
        </thead>
      <% end %>
  </thead>
  <tbody>
    <tr>
      <td>To</td>
      <td>Doe</td>
      <td>Software Engineer</td>
    </tr>
  </tbody>
</table>

