<h1>Home</h1>

    <div>
        <% if user_signed_in? %>
        <p>
            Welcome, <%=current_user.username%>
        </p>
        <% end %>
    </div>
    <%# friend requests %>
    <div>
        <%=link_to "Friend Requests", friend_requests_index_path %>
        <%=link_to "Your Profile", user_path(current_user)%>
    </div>


    <%# posts %>
    <div>
        <h2>Your Feed</h2>
        <% @feed.each do |post| %>
            <h5><%=post.subject%></h5>
            <h6><%=post.body%></h6>
            <%=button_to "Like" %>
        <% end %>
    </div>
    
    <div>
        <h2>Create Post</h2>
        <%= form_with model: @posts do |post| %>
            <%=post.label :subject, "Subject" %>
            <%=post.text_field :subject %><br>
            <%=post.label :body, "Body" %>
            <%=post.text_field :body %><br>
            <%=post.submit "Create Post" %>       
        <% end %>
    </div>
    
<p>
    <%=link_to "Sign Out", destroy_user_session_path, 'data-turbo-method': :delete%>
    <%=link_to "Sign Up!", new_user_registration_path %>
    <%=link_to "Login", new_user_session_path %>
</p>
